# Existing deployments can keep their environment variable names and values.
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/quiet-feed.db

# Public origin of the app, used for same-origin form checks.
ORIGIN=http://localhost:3000
# Retained as a fallback for ORIGIN for older deployments.
BETTER_AUTH_URL=http://localhost:3000

# KEEP your existing secret when upgrading: it also encrypts saved Gemini keys.
# For a NEW installation, generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me
# If previously set, keep this too; otherwise encryption uses BETTER_AUTH_SECRET.
# ENCRYPTION_KEY=

# false for HTTP (including a Pi on your LAN); true when served over HTTPS.
SECURE_COOKIES=false
ENABLE_INTERNAL_SCHEDULER=true

# Required only for external POST /api/cron/compile requests.
CRON_SECRET=change-me

# Trust forwarded headers only from your proxy IPs/CIDRs.
FORWARDED_ALLOW_IPS=127.0.0.1
# Legacy ADDRESS_HEADER, PROTOCOL_HEADER, HOST_HEADER, and XFF_DEPTH may remain
# in old configurations; the Python server does not use those variables.
